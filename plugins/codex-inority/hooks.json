{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/inority-context.mjs",
            "statusMessage": "Loading Codex Inority memory and reply context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/inority-context.mjs",
            "statusMessage": "Refreshing Codex Inority reply contract"
          }
        ]
      }
    ]
  }
}
