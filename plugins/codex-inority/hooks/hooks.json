{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/inority-context.mjs\"",
            "statusMessage": "Loading Codex Inority memory and reply context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/inority-context.mjs\"",
            "statusMessage": "Refreshing Codex Inority reply contract"
          }
        ]
      }
    ]
  }
}
