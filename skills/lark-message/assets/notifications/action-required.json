{
  "template": {
    "name": "action-required",
    "required": ["mention_open_id", "subject", "summary", "action", "deadline"]
  },
  "card": {
    "schema": "2.0",
    "config": {
      "update_multi": true,
      "width_mode": "default",
      "summary": { "content": "{{subject}}：需要处理" }
    },
    "header": {
      "title": { "tag": "plain_text", "content": "{{subject}}" },
      "subtitle": { "tag": "plain_text", "content": "需要处理" },
      "template": "yellow",
      "icon": { "tag": "standard_icon", "token": "todo_colorful" },
      "text_tag_list": [
        { "tag": "text_tag", "text": { "tag": "plain_text", "content": "待处理" }, "color": "yellow" }
      ]
    },
    "body": {
      "direction": "vertical",
      "padding": "12px 12px 20px 12px",
      "vertical_spacing": "12px",
      "elements": [
        {
          "tag": "column_set",
          "flex_mode": "none",
          "background_style": "yellow-50",
          "columns": [
            {
              "tag": "column",
              "width": "weighted",
              "weight": 1,
              "padding": "12px",
              "vertical_spacing": "4px",
              "elements": [
                { "tag": "markdown", "content": "<at id={{mention_open_id}}></at>，**<font color='orange'>{{summary}}</font>**" }
              ]
            }
          ]
        },
        {
          "tag": "column_set",
          "flex_mode": "none",
          "columns": [
            {
              "tag": "column",
              "width": "weighted",
              "weight": 1,
              "background_style": "green-50",
              "padding": "12px",
              "vertical_spacing": "4px",
              "elements": [
                { "tag": "markdown", "content": "**<font color='green'>解决方案</font>**\n{{action}}" },
                { "tag": "markdown", "content": "<font color='grey'>观察阈值：{{deadline}}</font>", "text_size": "notation" }
              ]
            }
          ]
        }
      ]
    }
  }
}
