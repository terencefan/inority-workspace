{
  "name": "inority-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace control-plane source repo for Codex assets, memory, and handbook tooling.",
  "workspaces": [
    "handbook"
  ],
  "scripts": {
    "codex:install:memory": "node ./plugins/codex-inority/skills/inority-memory-maintenance/scripts/install.mjs",
    "codex:uninstall:memory": "node ./plugins/codex-inority/skills/inority-memory-maintenance/scripts/uninstall.mjs",
    "codex:install:plugin": "codex plugin marketplace add . && codex plugin add codex-inority@personal",
    "codex:uninstall:plugin": "codex plugin remove codex-inority",
    "codex:install": "npm run codex:install:memory && npm run codex:install:plugin",
    "codex:uninstall": "npm run codex:uninstall:plugin && npm run codex:uninstall:memory",
    "handbook:dev": "npm run dev --workspace handbook",
    "handbook:build": "npm run build --workspace handbook",
    "handbook:start": "npm run start --workspace handbook",
    "handbook:test": "npm run test --workspace handbook",
    "handbook:lint": "npm run lint --workspace handbook",
    "dot:test": "node ./skills/draw-dot/tests/run.mjs",
    "runbook:test": "node ./skills/runbook/tests/run.mjs",
    "slides:test": "node ./skills/inority-slides/tests/run.mjs",
    "doc:test": "node ./skills/write-doc/tests/run.mjs",
    "benchmark:skill:test": "node --test ./skills/benchmark/tests/validate.test.mjs"
  }
}
