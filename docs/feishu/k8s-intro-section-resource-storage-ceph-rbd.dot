digraph pvc_storageclass_cephrbd {
  graph [
    rankdir=LR,
    bgcolor="#020617",
    fontname="Noto Sans CJK SC",
    pad="0.2",
    nodesep="0.5",
    ranksep="0.9"
  ];

  node [
    fontname="Noto Sans CJK SC",
    shape=box,
    style="filled",
    penwidth=1.4
  ];

  edge [
    fontname="Noto Sans CJK SC",
    color="#e5e7eb",
    fontcolor="#e5e7eb",
    penwidth=1.5,
    arrowsize=0.8
  ];

  pod [label="Pod\n挂载卷", fillcolor="#166534", color="#86efac", fontcolor="#f8fafc"];
  pvc [label="PVC\n声明容量 / 访问模式", fillcolor="#1d4ed8", color="#93c5fd", fontcolor="#f8fafc"];
  sc [label="StorageClass\n指定 provisioner / 参数", fillcolor="#92400e", color="#fcd34d", fontcolor="#f8fafc"];
  pv [label="PV\n动态创建出的卷", fillcolor="#1f2937", color="#cbd5e1", fontcolor="#f8fafc"];
  ceph [label="ceph-rbd\n后端块存储池", fillcolor="#9a3412", color="#fdba74", fontcolor="#f8fafc"];

  pod -> pvc [label="使用申请结果"];
  pvc -> sc [label="引用 storageClassName"];
  sc -> ceph [label="调用 ceph-rbd provisioner"];
  ceph -> pv [label="创建 RBD 卷"];
  pv -> pvc [label="绑定返回", style=dashed];
}
