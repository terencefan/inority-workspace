digraph k8s_data_plane_components {
  graph [
    rankdir=LR,
    bgcolor="#020617",
    fontname="Noto Sans CJK SC",
    pad="0.2",
    nodesep="0.45",
    ranksep="0.8"
  ];

  node [
    fontname="Noto Sans CJK SC",
    shape=box,
    style="filled",
    penwidth=1.4
  ];

  edge [
    fontname="Noto Sans CJK SC",
    color="#e5e7eb",
    fontcolor="#e5e7eb",
    penwidth=1.5,
    arrowsize=0.8
  ];

  subgraph cluster_workload {
    label="工作负载对象";
    color="#cbd5e1";
    fontcolor="#f8fafc";
    style="solid";

    deployment [label="Deployment", fillcolor="#1d4ed8", color="#93c5fd", fontcolor="#f8fafc"];
    replicaset [label="ReplicaSet", fillcolor="#1d4ed8", color="#93c5fd", fontcolor="#f8fafc"];
  }

  subgraph cluster_service_plane {
    label="服务与 Pod 视图";
    color="#99f6e4";
    fontcolor="#f8fafc";
    style="solid";

    service [label="Service", fillcolor="#0f766e", color="#99f6e4", fontcolor="#f8fafc"];
    pod_group [label="Pod 集合", fillcolor="#166534", color="#86efac", fontcolor="#f8fafc"];
  }

  subgraph cluster_node_a {
    label="工作节点 / 数据面执行层";
    color="#86efac";
    fontcolor="#f8fafc";
    style="solid";

    kubelet [label="kubelet", fillcolor="#92400e", color="#fcd34d", fontcolor="#f8fafc"];
    runtime [label="Container Runtime", fillcolor="#92400e", color="#fcd34d", fontcolor="#f8fafc"];
    pod_a [label="Pod A", fillcolor="#166534", color="#86efac", fontcolor="#f8fafc"];
    pod_b [label="Pod B", fillcolor="#166534", color="#86efac", fontcolor="#f8fafc"];
    container_a [label="Container", fillcolor="#1f2937", color="#cbd5e1", fontcolor="#f8fafc"];
    container_b [label="Container", fillcolor="#1f2937", color="#cbd5e1", fontcolor="#f8fafc"];
  }

  deployment -> replicaset [label="声明版本"];
  replicaset -> pod_group [label="维持副本集合"];
  service -> pod_group [label="选择后端"];
  pod_group -> pod_a [label="跨节点分布"];
  pod_group -> pod_b;
  kubelet -> runtime [label="调用运行时"];
  kubelet -> pod_a [label="托管 Pod"];
  runtime -> pod_b [label="启动容器进程"];
  pod_a -> container_a;
  pod_b -> container_b;
}
