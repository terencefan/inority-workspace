digraph k8s_data_plane {
  graph [
    rankdir=LR,
    bgcolor="#020617",
    fontname="Noto Sans CJK SC",
    pad="0.2",
    nodesep="0.45",
    ranksep="0.8"
  ];

  node [
    fontname="Noto Sans CJK SC",
    shape=box,
    style="filled",
    penwidth=1.4
  ];

  edge [
    fontname="Noto Sans CJK SC",
    color="#e5e7eb",
    fontcolor="#e5e7eb",
    penwidth=1.5,
    arrowsize=0.8
  ];

  api_server [label="API Server", fillcolor="#1d4ed8", color="#93c5fd", fontcolor="#f8fafc"];
  scheduler [label="Scheduler", fillcolor="#92400e", color="#fcd34d", fontcolor="#f8fafc"];
  kubelet [label="kubelet", fillcolor="#0f766e", color="#99f6e4", fontcolor="#f8fafc"];
  runtime [label="Container Runtime", fillcolor="#0f766e", color="#99f6e4", fontcolor="#f8fafc"];
  pod_a [label="Pod A", fillcolor="#166534", color="#86efac", fontcolor="#f8fafc"];
  pod_b [label="Pod B", fillcolor="#166534", color="#86efac", fontcolor="#f8fafc"];
  service [label="Service\n稳定访问入口", fillcolor="#0f766e", color="#99f6e4", fontcolor="#f8fafc"];
  user_traffic [label="业务流量", fillcolor="#1f2937", color="#cbd5e1", fontcolor="#f8fafc"];

  api_server -> kubelet [label="下发 PodSpec"];
  scheduler -> api_server [label="绑定节点", style=dashed];
  kubelet -> runtime [label="调用运行时"];
  runtime -> pod_a [label="拉起容器"];
  runtime -> pod_b [label="拉起容器"];
  service -> pod_a [label="选择后端"];
  service -> pod_b [label="选择后端"];
  user_traffic -> service [label="访问入口"];
}
