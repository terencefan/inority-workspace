digraph k8s_control_plane {
  graph [
    rankdir=LR,
    bgcolor="#020617",
    fontname="Noto Sans CJK SC",
    pad="0.2",
    nodesep="0.45",
    ranksep="0.8"
  ];

  node [
    fontname="Noto Sans CJK SC",
    shape=box,
    style="filled",
    penwidth=1.4
  ];

  edge [
    fontname="Noto Sans CJK SC",
    color="#e5e7eb",
    fontcolor="#e5e7eb",
    penwidth=1.5,
    arrowsize=0.8
  ];

  user_ci [label="用户 / CI\n提交应用配置", fillcolor="#1d4ed8", color="#93c5fd", fontcolor="#f8fafc"];
  api_server [label="API Server", fillcolor="#1e40af", color="#93c5fd", fontcolor="#f8fafc"];
  etcd [label="etcd", fillcolor="#1d4ed8", color="#93c5fd", fontcolor="#f8fafc"];
  scheduler [label="Scheduler", fillcolor="#92400e", color="#fcd34d", fontcolor="#f8fafc"];
  controller [label="Controller", fillcolor="#92400e", color="#fcd34d", fontcolor="#f8fafc"];

  user_ci -> api_server [label="提交期望状态"];
  api_server -> etcd [label="保存资源对象"];
  api_server -> scheduler [label="暴露待调度信息"];
  api_server -> controller [label="暴露资源状态"];
  etcd -> controller [label="提供期望状态", style=dashed];
  scheduler -> api_server [label="回写绑定结果", style=dashed];
  controller -> api_server [label="更新资源状态", style=dashed];
}
